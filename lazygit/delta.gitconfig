# generated by quickshell from quickshell/theme/dark.json; edit the palette there
[delta]
    dark = true
    syntax-theme = ansi
    line-numbers = true
    minus-style = syntax "#362525"
    minus-emph-style = syntax "#603a3b"
    plus-style = syntax "#2c3025"
    plus-emph-style = syntax "#49523b"
    line-numbers-minus-style = "#e67e80"
    line-numbers-plus-style = "#a7c080"
    line-numbers-zero-style = "#5a5a5a"
    line-numbers-left-style = "#3a3a3a"
    line-numbers-right-style = "#3a3a3a"
    file-style = "#cfcfcf" bold
    file-decoration-style = "#3a3a3a" ul
    hunk-header-style = file line-number syntax
    hunk-header-file-style = "#808080"
    hunk-header-line-number-style = "#808080"
    hunk-header-decoration-style = "#3a3a3a" box
    whitespace-error-style = "#e67e80" reverse
