# Aliases

# general
alias zhr='source ~/.zshrc'
alias pacu='sudo pacman -Syu'
alias ubu='sudo apt update & upgrade'
alias lg='lazygit'

#git aliases
alias ga='git add .'
alias gp='git push .'

#utility
alias get_monitors='swaymsg -t get_outputs'

# misc
alias ff='fastfetch'

# enables ls color output; the actual colors (e.g. muted green directories)
# come from the active ghostty theme's palette, see ghostty/themes/<theme>
alias ls='ls --color=auto'
