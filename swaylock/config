# studio1804 Monochrome — matches ghostty/waybar/k9s/mako theme
# Mostly grayscale; green = correct keypress, red = wrong.

color=000000

indicator-idle-visible
indicator-radius=100
indicator-thickness=10

font=JetBrains Mono Nerd Font
font-size=22

ignore-empty-password

# Idle / inputting
ring-color=868686
inside-color=000000
line-color=000000
text-color=c6c8cd
separator-color=333333

# Verifying (Enter pressed, waiting on PAM)
ring-ver-color=868686
inside-ver-color=000000
text-ver-color=c6c8cd

# Cleared (backspaced to empty)
ring-clear-color=686868
inside-clear-color=000000
text-clear-color=c6c8cd

# Wrong password
ring-wrong-color=704d4d
inside-wrong-color=000000
line-wrong-color=000000
text-wrong-color=f2f4f8

# Per-keystroke feedback
key-hl-color=4d704d
bs-hl-color=686868

# Caps lock
ring-caps-lock-color=704d4d
text-caps-lock-color=f2f4f8

# On-screen keyboard layout indicator
layout-bg-color=000000
layout-border-color=333333
layout-text-color=c6c8cd
