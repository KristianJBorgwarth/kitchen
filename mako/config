# studio1804 Monochrome — matches ghostty/waybar/k9s theme
# Mostly grayscale; green/red are reserved for urgency signal only.

max-history=20
sort=-time
default-timeout=6000
max-visible=5
layer=overlay
anchor=top-right
outer-margin=50,15
margin=10
padding=12,16

font=JetBrains Mono Nerd Font 11
markup=1
format=<b>%s</b>\n%b
text-alignment=left
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=4

width=340
height=110
border-size=2
border-radius=8

background-color=#1e1e1ef2
text-color=#f2f4f8ff
border-color=#404040ff
progress-color=over #5fd75fff

on-button-left=dismiss
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu -p 'Action:'
on-button-right=dismiss-all
on-touch=dismiss

[urgency=low]
border-color=#404040ff
text-color=#a0a0a0ff
default-timeout=4000

[urgency=critical]
border-color=#ff5f5fff
text-color=#f2f4f8ff
progress-color=over #ff5f5fff
default-timeout=0

[hidden]
format=(%h more)
