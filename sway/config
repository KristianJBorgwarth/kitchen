### Variables
include config.d/vars
include config.d/input
include config.d/appearance
include config.d/workspaces
include config.d/keybinds
include config.d/waybar

### Autostart
exec_always pkill -x swayosd-server; swayosd-server
exec_always pkill -x waybar; waybar
exec_always pkill -x mako; mako
exec_always pkill -x autotiling; ~/.local/bin/autotiling
exec_always pkill -x kanshi; kanshi
exec_always pkill -x nm-applet; nm-applet --indicator
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec ~/.local/bin/waypaper --restore
