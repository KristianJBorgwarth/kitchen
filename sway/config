### Variables
include config.d/vars
include config.d/input
include config.d/appearance
include config.d/workspaces
include config.d/keybinds
include config.d/waybar

### Autostart
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP

# GTK4/libadwaita and portal-aware apps (Firefox, etc.) ignore settings.ini's
# gtk-application-prefer-dark-theme; they read color-scheme from GSettings.
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark

exec_always pkill -x swayosd-server; swayosd-server
exec_always pkill -x waybar; waybar
exec_always pkill -x mako; mako
exec_always pkill -x autotiling; ~/.local/bin/autotiling
exec_always pkill -x kanshi; kanshi
exec_always pkill -x nm-applet; nm-applet --indicator
exec env PATH="$PATH:$HOME/go/bin" wl-paste --type text --watch cliphist store
exec env PATH="$PATH:$HOME/go/bin" wl-paste --type image --watch cliphist store
exec /usr/bin/waypaper --restore
