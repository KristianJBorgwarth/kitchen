pragma Singleton

import QtQuick
import Quickshell
import Quickshell.I3
import Quickshell.Io
import qs.core

// Writes other apps' colors from the palette (Main.theme): a ghostty theme, sway's window
// border colors (also applied live) and the palette block of the k9s skin. A file is only
// rewritten when its content changes, so this doesn't churn git.
Singleton {
    id: root
    readonly property var p: Main.theme.palette
    readonly property string name: p.name ?? "kitchen-dark"
    readonly property string home: Quickshell.env("HOME")
    readonly property string banner: "generated by quickshell from quickshell/theme/" + Main.theme.name + ".json; edit the palette there"

    // "@fg" refers to another palette entry
    function c(v) {
        return String(v).startsWith("@") ? p[String(v).slice(1)] : v;
    }
    function bare(v) {
        return c(v).replace("#", "");
    }

    function ghostty() {
        const t = p.terminal;
        return ["# " + banner, ""].concat(t.ansi.map((v, i) => "palette = " + i + "=" + bare(v)), ["", "background = " + bare(t.background), "foreground = " + bare(t.foreground), "cursor-color = " + bare(t.cursor), ""]).join("\n");
    }

    // border, background, text, indicator, child border
    function swayLines() {
        const row = (cls, a, b, t) => cls.padEnd(24) + [a, a, t, a, b].map(c).join(" ");
        return [row("client.focused", "@fg", "@fg", "@bg"), row("client.focused_inactive", "@dim", "@dim", "@fg"), row("client.unfocused", "@muted", "@muted", "@mid"), row("client.urgent", "@red", "@red", "@fg")];
    }
    function sway() {
        return ["# " + banner].concat(swayLines(), [""]).join("\n");
    }

    // only the anchors block between the markers; the rest of the skin is hand-written
    function k9s(current) {
        const begin = "# --- palette: " + banner + " ---";
        const end = "# --- end palette ---";
        const block = [begin, 'fg: &fg "' + c("@fg") + '"', 'bright: &bright "' + c("@fg") + '"', 'dim: &dim "' + c("@mid") + '"', 'muted: &muted "' + c("@dim") + '"', 'faint: &faint "' + c("@muted") + '"', 'dark: &dark "' + c("@bg") + '"', 'green: &green "' + c("@green") + '"', 'red: &red "' + c("@red") + '"', end].join("\n");
        const m = current.match(/# --- palette:[^\n]*\n[\s\S]*?# --- end palette ---/);
        return m ? current.replace(m[0], block) : current;
    }

    FileView {
        id: ghosttyFile
        path: root.home + "/.config/ghostty/themes/" + root.name + ".conf"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: swayFile
        path: root.home + "/.config/sway/config.d/colors"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: k9sFile
        path: root.home + "/.config/k9s/skins/kitchen.yaml"
        blockLoading: true
        printErrors: false
    }

    function write(file, text) {
        // runs once before the paths are bound; the next pass writes
        if (!file.path || file.text() === text)
            return false;
        file.setText(text);
        return true;
    }

    function exportAll() {
        if (!p.terminal)
            return;
        write(ghosttyFile, ghostty());
        if (write(swayFile, sway())) {
            for (const line of swayLines())
                I3.dispatch(line);
        }
        if (k9sFile.text())
            write(k9sFile, k9s(k9sFile.text()));
    }

    onPChanged: exportAll()
    Component.onCompleted: exportAll()
}
