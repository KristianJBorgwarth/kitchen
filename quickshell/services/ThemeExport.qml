pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.core

// Writes other apps' colors from the palettes: ghostty themes for both modes (ghostty picks
// one from the system color scheme), and for the active mode sway's window border colors
// (also applied live), the palette block of the k9s skin, and lazygit's theme block and
// delta config. Switching modes also sets the
// system color scheme and GTK/icon themes, which Brave, GTK apps and ghostty follow. A file
// is only rewritten when its content changes, so this doesn't churn git.
Singleton {
    id: root
    readonly property var p: Main.theme.palette
    readonly property string home: Quickshell.env("HOME")
    readonly property bool dark: Main.theme.dark

    function banner(mode) {
        return "generated by quickshell from quickshell/theme/" + mode + ".json; edit the palette there";
    }

    // "@fg" refers to another entry of the same palette
    function c(v, pal) {
        pal = pal ?? p;
        return String(v).startsWith("@") ? pal[String(v).slice(1)] : v;
    }

    function ghostty(pal, mode) {
        const t = pal.terminal;
        const bare = v => c(v, pal).replace("#", "");
        return ["# " + banner(mode), ""].concat(t.ansi.map((v, i) => "palette = " + i + "=" + bare(v)), ["", "background = " + bare(t.background), "foreground = " + bare(t.foreground), "cursor-color = " + bare(t.cursor), ""]).join("\n");
    }

    // border, background, text, indicator, child border
    function swayLines() {
        const row = (cls, a, b, t) => cls.padEnd(24) + [a, a, t, a, b].map(v => c(v)).join(" ");
        return [row("client.focused", "@fg", "@fg", "@bg"), row("client.focused_inactive", "@dim", "@dim", "@fg"), row("client.unfocused", "@muted", "@muted", "@mid"), row("client.urgent", "@red", "@red", "@fg")];
    }
    function sway() {
        return ["# " + banner(Main.theme.name)].concat(swayLines(), [""]).join("\n");
    }

    // Hyprland reloads its config when this changes
    function hypr() {
        const rgb = v => "rgb(" + c(v).slice(1) + ")";
        return ["-- " + banner(Main.theme.name), "hl.config({", "    general = {", "        col = {", '            active_border = "' + rgb("@fg") + '",', '            inactive_border = "' + rgb("@muted") + '",', "        },", "    },", "})", ""].join("\n");
    }

    // a over b, `t` of the way: "#rrggbb"
    function mix(a, b, t) {
        const ch = (h, i) => parseInt(String(h).slice(1 + 2 * i, 3 + 2 * i), 16);
        return "#" + [0, 1, 2].map(i => Math.round(ch(a, i) * t + ch(b, i) * (1 - t)).toString(16).padStart(2, "0")).join("");
    }

    // lazygit's diff renderer. Code keeps its syntax colors (the "ansi" theme is the terminal
    // palette) over a soft red/green line tint, a stronger one on the words that changed
    function delta() {
        // read here rather than root.dark: on a switch the palette changes (and this runs)
        // before that binding catches up
        const dark = Main.theme.dark;
        const t = p.terminal;
        const bg = c(t.background);
        const red = c(t.ansi[1]);
        const green = c(t.ansi[2]);
        const soft = dark ? 0.16 : 0.2;
        const strong = dark ? 0.36 : 0.42;
        const q = v => '"' + v + '"';
        return ["# " + banner(Main.theme.name), "[delta]",
            "    " + (dark ? "dark" : "light") + " = true",
            "    syntax-theme = ansi",
            "    line-numbers = true",
            "    minus-style = syntax " + q(mix(red, bg, soft)),
            "    minus-emph-style = syntax " + q(mix(red, bg, strong)),
            "    plus-style = syntax " + q(mix(green, bg, soft)),
            "    plus-emph-style = syntax " + q(mix(green, bg, strong)),
            "    line-numbers-minus-style = " + q(red),
            "    line-numbers-plus-style = " + q(green),
            "    line-numbers-zero-style = " + q(c("@dim")),
            "    line-numbers-left-style = " + q(c("@muted")),
            "    line-numbers-right-style = " + q(c("@muted")),
            "    file-style = " + q(c("@fg")) + " bold",
            "    file-decoration-style = " + q(c("@muted")) + " ul",
            "    hunk-header-style = file line-number syntax",
            "    hunk-header-file-style = " + q(c("@mid")),
            "    hunk-header-line-number-style = " + q(c("@mid")),
            "    hunk-header-decoration-style = " + q(c("@muted")) + " box",
            "    whitespace-error-style = " + q(red) + " reverse",
            ""].join("\n");
    }

    // only the theme block between the markers; the rest of the config is hand-written
    function lazygit(current) {
        const t = p.terminal;
        const col = (v, bold) => '["' + c(v) + '"' + (bold ? ", bold" : "") + "]";
        const block = ["  # --- theme: " + banner(Main.theme.name) + " ---", "  theme:",
            "    activeBorderColor: " + col(t.ansi[2], true),
            "    inactiveBorderColor: " + col("@dim"),
            "    searchingActiveBorderColor: " + col(t.ansi[3], true),
            "    optionsTextColor: " + col("@mid"),
            "    selectedLineBgColor: " + col("@muted"),
            "    inactiveViewSelectedLineBgColor: " + col("@surface"),
            "    cherryPickedCommitFgColor: " + col(t.ansi[4]),
            "    cherryPickedCommitBgColor: " + col("@surface"),
            "    markedBaseCommitFgColor: " + col(t.ansi[3]),
            "    markedBaseCommitBgColor: " + col("@surface"),
            "    unstagedChangesColor: " + col(t.ansi[1]),
            "    defaultFgColor: [default]",
            "  # --- end theme ---"].join("\n");
        const m = current.match(/  # --- theme:[^\n]*\n[\s\S]*?  # --- end theme ---/);
        return m ? current.replace(m[0], block) : current;
    }

    // only the anchors block between the markers; the rest of the skin is hand-written
    function k9s(current) {
        const begin = "# --- palette: " + banner(Main.theme.name) + " ---";
        const end = "# --- end palette ---";
        const block = [begin, 'fg: &fg "' + c("@fg") + '"', 'bright: &bright "' + c("@fg") + '"', 'dim: &dim "' + c("@mid") + '"', 'muted: &muted "' + c("@dim") + '"', 'faint: &faint "' + c("@muted") + '"', 'dark: &dark "' + c("@bg") + '"', 'green: &green "' + c("@green") + '"', 'red: &red "' + c("@red") + '"', end].join("\n");
        const m = current.match(/# --- palette:[^\n]*\n[\s\S]*?# --- end palette ---/);
        return m ? current.replace(m[0], block) : current;
    }

    FileView {
        id: gtk3
        path: root.home + "/.config/gtk-3.0/settings.ini"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: gtk4
        path: root.home + "/.config/gtk-4.0/settings.ini"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: ghosttyDark
        path: root.home + "/.config/ghostty/themes/kitchen-dark.conf"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: ghosttyLight
        path: root.home + "/.config/ghostty/themes/kitchen-light.conf"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: swayFile
        path: root.home + "/.config/sway/config.d/colors"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: hyprFile
        path: root.home + "/.config/hypr/conf/colors.lua"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: lazygitFile
        path: root.home + "/.config/lazygit/config.yml"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: deltaFile
        path: root.home + "/.config/lazygit/delta.gitconfig"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: k9sFile
        path: root.home + "/.config/k9s/skins/kitchen.yaml"
        blockLoading: true
        printErrors: false
    }

    function write(file, text) {
        // runs once before the paths are bound; the next pass writes
        if (!file.path || file.text() === text)
            return false;
        file.setText(text);
        return true;
    }

    // GTK apps (Thunar) and Electron/Chromium ones (Discord) take light/dark from here at
    // startup rather than live from the system setting, so it's rewritten per mode. The theme
    // stays "Adwaita" (GTK3's built-in; "Adwaita-dark" only exists with gnome-themes-extra),
    // and prefer-dark picks its dark variant
    function gtkSettings() {
        const d = Main.theme.dark;
        return ["# generated by quickshell's theme switch (ThemeExport); per mode, so not in git", "[Settings]", "gtk-theme-name=Adwaita", "gtk-application-prefer-dark-theme=" + (d ? 1 : 0), "gtk-icon-theme-name=" + (d ? "Papirus-Dark" : "Papirus"), "gtk-cursor-theme-name=Adwaita", "gtk-cursor-theme-size=24", "gtk-font-name=JetBrains Mono Nerd Font 10", ""].join("\n");
    }

    function exportAll() {
        if (!p.terminal)
            return;
        write(gtk3, gtkSettings());
        write(gtk4, gtkSettings());
        for (const [file, pal, mode] of [[ghosttyDark, Main.theme.darkPalette, "dark"], [ghosttyLight, Main.theme.lightPalette, "light"]]) {
            if (pal.terminal)
                write(file, ghostty(pal, mode));
        }
        if (Compositor.hypr) {
            write(hyprFile, hypr());
        } else if (write(swayFile, sway())) {
            // quoted: over IPC a bare "#" starts a comment and swallows the colors
            for (const line of swayLines())
                Compositor.sway(line.replace(/(#[0-9a-fA-F]{6})/g, '"$1"'));
        }
        if (k9sFile.text())
            write(k9sFile, k9s(k9sFile.text()));
        if (lazygitFile.text()) {
            write(lazygitFile, lazygit(lazygitFile.text()));
            write(deltaFile, delta());
        }
    }

    // color-scheme reaches libadwaita apps, Brave and ghostty through the desktop portal;
    // GTK3 apps (Thunar…) only follow the theme name
    Process {
        id: appearance
    }

    // the command is built here rather than bound: a binding can still hold the previous
    // mode when this runs
    function applyAppearance() {
        const d = Main.theme.dark;
        appearance.command = ["sh", "-c", "gsettings set org.gnome.desktop.interface color-scheme prefer-" + (d ? "dark" : "light") + "; gsettings set org.gnome.desktop.interface gtk-theme Adwaita; gsettings set org.gnome.desktop.interface icon-theme " + (d ? "Papirus-Dark" : "Papirus")];
        appearance.running = true;
    }

    onPChanged: exportAll()
    // both ghostty themes are written, so an edit to the inactive palette counts too
    Connections {
        target: Main.theme
        function onDarkPaletteChanged() {
            root.exportAll();
        }
        function onLightPaletteChanged() {
            root.exportAll();
        }
    }
    onDarkChanged: {
        applyAppearance();
        write(gtk3, gtkSettings());
        write(gtk4, gtkSettings());
    }
    Component.onCompleted: {
        exportAll();
        // the first pass can run before the file paths are bound (see write()), so again
        // once they are: picks up palette edits made while quickshell wasn't running
        Qt.callLater(exportAll);
        applyAppearance();
    }
}
