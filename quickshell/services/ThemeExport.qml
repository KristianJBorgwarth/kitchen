pragma Singleton

import QtQuick
import Quickshell
import Quickshell.I3
import Quickshell.Io
import qs.core

// Writes other apps' colors from the palettes: ghostty themes for both modes (ghostty picks
// one from the system color scheme), and for the active mode sway's window border colors
// (also applied live) and the palette block of the k9s skin. Switching modes also sets the
// system color scheme and GTK/icon themes, which Brave, GTK apps and ghostty follow. A file
// is only rewritten when its content changes, so this doesn't churn git.
Singleton {
    id: root
    readonly property var p: Main.theme.palette
    readonly property string home: Quickshell.env("HOME")
    readonly property bool dark: Main.theme.dark

    function banner(mode) {
        return "generated by quickshell from quickshell/theme/" + mode + ".json; edit the palette there";
    }

    // "@fg" refers to another entry of the same palette
    function c(v, pal) {
        pal = pal ?? p;
        return String(v).startsWith("@") ? pal[String(v).slice(1)] : v;
    }

    function ghostty(pal, mode) {
        const t = pal.terminal;
        const bare = v => c(v, pal).replace("#", "");
        return ["# " + banner(mode), ""].concat(t.ansi.map((v, i) => "palette = " + i + "=" + bare(v)), ["", "background = " + bare(t.background), "foreground = " + bare(t.foreground), "cursor-color = " + bare(t.cursor), ""]).join("\n");
    }

    // border, background, text, indicator, child border
    function swayLines() {
        const row = (cls, a, b, t) => cls.padEnd(24) + [a, a, t, a, b].map(v => c(v)).join(" ");
        return [row("client.focused", "@fg", "@fg", "@bg"), row("client.focused_inactive", "@dim", "@dim", "@fg"), row("client.unfocused", "@muted", "@muted", "@mid"), row("client.urgent", "@red", "@red", "@fg")];
    }
    function sway() {
        return ["# " + banner(Main.theme.name)].concat(swayLines(), [""]).join("\n");
    }

    // only the anchors block between the markers; the rest of the skin is hand-written
    function k9s(current) {
        const begin = "# --- palette: " + banner(Main.theme.name) + " ---";
        const end = "# --- end palette ---";
        const block = [begin, 'fg: &fg "' + c("@fg") + '"', 'bright: &bright "' + c("@fg") + '"', 'dim: &dim "' + c("@mid") + '"', 'muted: &muted "' + c("@dim") + '"', 'faint: &faint "' + c("@muted") + '"', 'dark: &dark "' + c("@bg") + '"', 'green: &green "' + c("@green") + '"', 'red: &red "' + c("@red") + '"', end].join("\n");
        const m = current.match(/# --- palette:[^\n]*\n[\s\S]*?# --- end palette ---/);
        return m ? current.replace(m[0], block) : current;
    }

    FileView {
        id: gtk3
        path: root.home + "/.config/gtk-3.0/settings.ini"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: gtk4
        path: root.home + "/.config/gtk-4.0/settings.ini"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: ghosttyDark
        path: root.home + "/.config/ghostty/themes/kitchen-dark.conf"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: ghosttyLight
        path: root.home + "/.config/ghostty/themes/kitchen-light.conf"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: swayFile
        path: root.home + "/.config/sway/config.d/colors"
        blockLoading: true
        printErrors: false
    }
    FileView {
        id: k9sFile
        path: root.home + "/.config/k9s/skins/kitchen.yaml"
        blockLoading: true
        printErrors: false
    }

    function write(file, text) {
        // runs once before the paths are bound; the next pass writes
        if (!file.path || file.text() === text)
            return false;
        file.setText(text);
        return true;
    }

    // GTK apps (Thunar) and Electron/Chromium ones (Discord) take light/dark from here at
    // startup rather than live from the system setting, so it's rewritten per mode. The theme
    // stays "Adwaita" (GTK3's built-in; "Adwaita-dark" only exists with gnome-themes-extra),
    // and prefer-dark picks its dark variant
    function gtkSettings() {
        const d = Main.theme.dark;
        return ["# generated by quickshell's theme switch (ThemeExport); per mode, so not in git", "[Settings]", "gtk-theme-name=Adwaita", "gtk-application-prefer-dark-theme=" + (d ? 1 : 0), "gtk-icon-theme-name=" + (d ? "Papirus-Dark" : "Papirus"), "gtk-cursor-theme-name=Adwaita", "gtk-cursor-theme-size=24", "gtk-font-name=JetBrains Mono Nerd Font 10", ""].join("\n");
    }

    function exportAll() {
        if (!p.terminal)
            return;
        write(gtk3, gtkSettings());
        write(gtk4, gtkSettings());
        for (const [file, pal, mode] of [[ghosttyDark, Main.theme.darkPalette, "dark"], [ghosttyLight, Main.theme.lightPalette, "light"]]) {
            if (pal.terminal)
                write(file, ghostty(pal, mode));
        }
        if (write(swayFile, sway())) {
            // quoted: over IPC a bare "#" starts a comment and swallows the colors
            for (const line of swayLines())
                I3.dispatch(line.replace(/(#[0-9a-fA-F]{6})/g, '"$1"'));
        }
        if (k9sFile.text())
            write(k9sFile, k9s(k9sFile.text()));
    }

    // color-scheme reaches libadwaita apps, Brave and ghostty through the desktop portal;
    // GTK3 apps (Thunar…) only follow the theme name
    Process {
        id: appearance
    }

    // the command is built here rather than bound: a binding can still hold the previous
    // mode when this runs
    function applyAppearance() {
        const d = Main.theme.dark;
        appearance.command = ["sh", "-c", "gsettings set org.gnome.desktop.interface color-scheme prefer-" + (d ? "dark" : "light") + "; gsettings set org.gnome.desktop.interface gtk-theme Adwaita; gsettings set org.gnome.desktop.interface icon-theme " + (d ? "Papirus-Dark" : "Papirus")];
        appearance.running = true;
    }

    onPChanged: exportAll()
    onDarkChanged: {
        applyAppearance();
        write(gtk3, gtkSettings());
        write(gtk4, gtkSettings());
    }
    Component.onCompleted: {
        exportAll();
        applyAppearance();
    }
}
